
GameConfig.CnfUpdateNotice=
{
    [1] = {
        updateContent = {
            {[["Warrior Card"-"Card Workshop"]], [[<COLOR VALUE=FFFFFF00> "Warrior Card" Appears. Warrior Continues. New Energy! </COLOR><BR><COLOR VALUE=FFFFFF00>Function On </COLOR><BR><COLOR VALUE=FFFFFF00>Player Lv. ?Y45 </COLOR>. Finish <COLOR VALUE=FFFFFF00> "Bats Fly"</COLOR>And Begin!<BR><COLOR VALUE=FFFFFF00>Function Site</COLOR><BR>After Opened, At VALUE=FFFFFF00>"Warrior Card"</COLOR> of <COLOR VALUE=FFFFFF00> "Helper's"</COLOR>Daily Activity Page<COLOR.<BR><COLOR VALUE=FFFFFF00>Description</COLOR><BR>1.Choose One Card.<BR>2.Make<COLOR VALUE=FFFF8A00>Warrior Piece</COLOR>.<BR>3.Make<COLOR VALUE=FF00FFFF>Man Pack</COLOR>Consumes<COLOR VALUE=FF00FFFF>Man Crystal</COLOR>.<BR>4.Make<COLOR VALUE=FFFB46FB>Ghost Pack</COLOR>Consumes<COLOR VALUE=FFFB46FB>Ghost Crystal</COLOR>.<BR>5.Make<COLOR VALUE=FFFF8A00>Immortal Pack</COLOR>Consumes<COLOR VALUE=FFFF8A00>Immortal Crystal</COLOR>.<BR>6.<COLOR VALUE=FFFF8A00>Warrior Piece</COLOR>Depends on Card!<BR>7.Get Materials in Mall, "Chang'er" & "Treasury".]], },
            {[["Warrior Card"-"Card Attached To The Body"]], [[<COLOR VALUE=FFFFFF00>Why Should I Collect The Cards? Thanks To The God, My Card Is Attached To My Body! </COLOR><BR><COLOR VALUE=FFFFFF00>Function Opened </COLOR><BR><COLOR VALUE=FFFFFF00>Player Lv.?Y45 </COLOR>; Task Done <COLOR VALUE=FFFFFF00>"Bats Flurry"</COLOR>, Open Now!<BR><COLOR VALUE=FFFFFF00>Function Position </COLOR><BR>After The Function Opened, Placed In The <COLOR VALUE=FFFFFF00> Helper </COLOR> Platte <COLOR VALUE=FFFFFF00> ?ú"Warrior Card"</COLOR> Icon .<BR><COLOR VALUE=FFFFFF00> Detail </COLOR><BR><COLOR VALUE=FFFFFF00>Card Equipment </COLOR><BR> 1. Player can Make Card In Card Workshop, And Choose Card To Equip Itself In Card Attached To The Body;<BR>E2. quipping Specified Card Can Add All Team Players' Attr. <BR><COLOR VALUE=FFFFFF00>Card Upgrade </COLOR><BR> 1. Card Upgrading Will Consume Some Same Type And Lv. Card, And Will Consume Some Material;<BR> 2. After The Card Is Upgraded, The Corresponding Attr. Will Also Be Upgraded.<BR><COLOR VALUE=FFFFFF00>Suit Effect </COLOR><BR>There Is Not Only Single Attached Attr., But Also Corresponding Suit Attr. On The Card, Card Well-Matched Can Get Privilage Attr.]], },
            {[[“Happy Spring Festival”“Eat Dumplings”]], [[<COLOR VALUE=FFFFFF00>Super Rewards for Spring Festival Event “Eat Dumplings”! Times waits for no one!</COLOR><BR><COLOR VALUE=FFFFFF00>Entry</COLOR><BR>“Helper” Fixed Time Event Page<COLOR VALUE=FFFFFF00>“Limited Event”</COLOR>Button<BR><COLOR VALUE=FFFFFF00>Instructions</COLOR><BR>1. Catch the dumplings with your bowl before they fall to the ground.<BR>2. The acquired dumplings are exchanged for points, which can be used to exchange precious items.<BR>3. HP will be decreased if struck by the bombs. The remaining HP is exchanged for points after the event finished.<BR>4. The game is divided into three stages and the difficulty will increase gradually. Dropout will cost a chance.<BR>5. In the final settlement, 1 dumpling is equal to 1 point, while 1 HP is equal to 10 points.<BR>6. When the event finished, the game will be forced to exit, during which the acquired dumplings will not be exchanged for points and the history remaining points will be exchanged for coins.]], },
            {[["Get Bonus" Of "Happy Spring Festival"]], [[<COLOR VALUE=FFFFFF00>Congratulations! The Second-"Get Bobus" Comes! </COLOR><BR><COLOR VALUE=FFFFFF00>Function Site </COLOR><BR>At "Time-limited Activity" <COLOR VALUE=FFFFFF00>Of</COLOR>Helper's Timely Activity Pag<BR><COLOR VALUE=FFFFFF00>Detail </COLOR><BR><BR><BR><BR><BR>]], },
            {[["Treasury" Of "Item Hunt"]], [[<COLOR VALUE=FFFFFF00>New Year Comes, Emperor Of Heaven Opens Treasury For Hunting.</COLOR><BR><COLOR VALUE=FFFFFF00>Function Open</COLOR><BR><COLOR VALUE=FFFFFF00>Player Lv.?Y53</COLOR>, Finish<COLOR VALUE=FFFFFF00>"Direction Under The Rose"</COLOR>, And Begin! <BR><COLOR VALUE=FFFFFF00>Function Site</COLOR><BR>After Opened, At <COLOR VALUE=FFFFFF00> "Item Hunt"Of "Helper's"  Daily Activity Interface</COLOR>.<BR><COLOR VALUE=FFFFFF00>Detail</COLOR><BR>1.Get Warrior Piece, Equip. Rank, Trump Lv.Up From Treasury;<BR>2.Choose Hunt Times. More Times, Better Treasures;<BR>3.Hunt With Diamond Or Heaven Token. Heaven Token Auto Used Available For Its QTY Matched Hunt Times;<BR>4.Heaven Token Preferred, Diamond Auto Used If Lack Heaven Token;<BR>5.Tresures Auto Put In Bag]], },
            {[[Optimize "Daily Task"]], [[1.Finishe<COLOR VALUE=FFFFFF00> "Chang'er"</COLOR>Daily Task, Rewards Change To<COLOR VALUE=FFFFFF00>Man Crystal</COLOR>, Which Can Forge To Card Pack <COLOR VALUE=FFFFFF00> "Man Pack"</COLOR>;<BR>2.Finishe<COLOR VALUE=FFFFFF00> "Happy Matching"</COLOR>Daily Task, Rewards Change To <COLOR VALUE=FFFFFF00> "Heaven Token""ììá?"</COLOR>, Which Can<COLOR VALUE=FFFFFF00> Search Treasure</COLOR>In God Treasury.]], },
