			fengce_gift_describe = [[<COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动时间:</COLOR><COLOR VALUE=FF442c20>开服后——游戏删档</COLOR><BR><COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动说明:</COLOR><COLOR VALUE=FF442c20>封测期间，每天</COLOR><COLOR VALUE=FF00B4FF>12:00-14:00 18:00-20:00</COLOR><COLOR VALUE=FF442c20>可在封测活动面板，领取丰厚的钻石奖励。</COLOR>]],
			fengce_bug_describe = [[<COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动时间:</COLOR><COLOR VALUE=FF442c20>开服后——游戏删档</COLOR><BR><COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动说明:</COLOR><COLOR VALUE=FF442c20>开服后，鼓励大家积极寻找游戏BUG，只要玩家发现并提交BUG到我们客服处，核实属实即可马上获得海量钻石奖励。</COLOR>]],
			fengce_bug_content = [[ <BR><COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动奖励:</COLOR><BR><COLOR VALUE=FF442c20>100—2000钻石%s、50元移动充值卡、100元移动充值卡。（视BUG情况而定）</COLOR><BR><COLOR VALUE=FFFFD200 OUTLINE=FF442c20>领取方式:</COLOR><BR><COLOR VALUE=FF442c20>玩家加入我们官方QQ交流群:</COLOR><COLOR VALUE=FF00B4FF>119527463</COLOR><COLOR VALUE=FF442c20>，将发现的BUG通知客服（群管理员）获得核实后，即可获得钻石、充值卡奖励。</COLOR><BR>]],
			fengce_vip_describe = [[<COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动时间:</COLOR><COLOR VALUE=FF442c20>开服后——游戏删档</COLOR><BR><COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动说明:</COLOR><COLOR VALUE=FF442c20>开服后，只要玩家达到<COLOR VALUE=FF00B4FF>15级</COLOR>，即可获得VIP8特权！</COLOR>]],
			fengce_vip_content = [[ <BR><COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动奖励:</COLOR><BR><COLOR VALUE=FF442c20>VIP8特权</COLOR><BR><COLOR VALUE=FFFFD200 OUTLINE=FF442c20>领取方式:</COLOR><BR><COLOR VALUE=FF442c20>升级到15级后自动获得。</COLOR><BR>]],
			fengce_upgrade_describe = [[<COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动时间:</COLOR><COLOR VALUE=FF442c20>新服开服后——永久</COLOR><BR><COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动说明:</COLOR><COLOR VALUE=FF442c20>新服开服后，只要玩家达到一定等级，即可马上获得冲级奖励。</COLOR>]],
			fengce_adv_describe = [[<COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动时间:</COLOR><COLOR VALUE=FF442c20>新服开服后—永久</COLOR><BR><COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动说明:</COLOR><COLOR VALUE=FF442c20>玩家通过自己对《光之刃》的亲身体验，写出您游戏中每一个玩法感受和自己独到的见解，一起分享给其他玩家，一起玩转光之刃！</COLOR>]],
			fengce_adv_content = [[ <BR><COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动奖励: </COLOR><BR><COLOR VALUE=FFFFFFFF OUTLINE=FF442c20>特等奖</COLOR><COLOR VALUE=FF442c20>（3名）：被客服GM评为特等奖即可获得：</COLOR><COLOR VALUE=FF00B4FF>2000</COLOR><COLOR VALUE=FF442c20>钻石、</COLOR></COLOR><COLOR VALUE=FF00B4FF>100元</COLOR></COLOR><COLOR VALUE=FF442c20>移动充值卡X2</COLOR><BR></COLOR><BR><COLOR VALUE=FFFFFFFF OUTLINE=FF442c20>一等奖</COLOR><COLOR VALUE=FF442c20>（5名）：被客服GM评为一等奖即可获得：</COLOR><COLOR VALUE=FF00B4FF>1000</COLOR><COLOR VALUE=FF442c20>钻石、</COLOR></COLOR><COLOR VALUE=FF00B4FF>100元</COLOR></COLOR><COLOR VALUE=FF442c20>移动充值卡X1</COLOR><BR><COLOR VALUE=FFFFFFFF OUTLINE=FF442c20>二等奖</COLOR><COLOR VALUE=FF442c20>（8名）：被客服GM评为二等奖即可获得：</COLOR><COLOR VALUE=FF00B4FF>500</COLOR><COLOR VALUE=FF442c20>钻石、</COLOR></COLOR><COLOR VALUE=FF00B4FF>50元</COLOR></COLOR><COLOR VALUE=FF442c20>移动充值卡X1</COLOR><BR><COLOR VALUE=FFFFFFFF OUTLINE=FF442c20>三等奖</COLOR><COLOR VALUE=FF442c20>（10名）：被客服GM评为三等奖即可获得：</COLOR><COLOR VALUE=FF00B4FF>200</COLOR><COLOR VALUE=FF442c20>钻石</COLOR><BR><COLOR VALUE=FFFFFFFF OUTLINE=FF442c20>参与奖</COLOR><COLOR VALUE=FF442c20>：凡是参与且符合活动要求的玩家均可获得：</COLOR><COLOR VALUE=FF00B4FF>50</COLOR><COLOR VALUE=FF442c20>钻石</COLOR><BR><COLOR VALUE=FF442c20>注：玩家可以发送多篇游戏建议，奖励可以重复领取！</COLOR><BR><COLOR VALUE=FFFFD200 OUTLINE=FF442c20>参与方式: </COLOR><BR><COLOR VALUE=FF442c20>玩家请将写好的游戏建议发送至邮箱：</COLOR><COLOR VALUE=FF00B4FF>2880609725@qq.com</COLOR><COLOR VALUE=FF442c20>我们客服会及时查收。</COLOR><BR><COLOR VALUE=FFFFD200 OUTLINE=FF442c20>建议格式: </COLOR><BR><COLOR VALUE=FFFFFFFF OUTLINE=FF442c20>1、</COLOR><COLOR VALUE=FF442c20>邮件标题：游戏建议征集，海量钻石无限送</COLOR><BR><COLOR VALUE=FFFFFFFF OUTLINE=FF442c20>2、</COLOR><COLOR VALUE=FF442c20>角色名：</COLOR><BR><COLOR VALUE=FFFFFFFF OUTLINE=FF442c20>3、</COLOR><COLOR VALUE=FF442c20>我的建议：</COLOR><BR><COLOR VALUE=FFFFD200 OUTLINE=FF442c20>温馨提示: </COLOR><BR><COLOR VALUE=FFFFFFFF OUTLINE=FF442c20>1、</COLOR><COLOR VALUE=FF442c20>攻略或者心得内容要健康。</COLOR><BR><COLOR VALUE=FFFFFFFF OUTLINE=FF442c20>2、</COLOR><COLOR VALUE=FF442c20>请务必写上攻略题目和角色名，以便我们客服人员快速定位攻略内容和最终的奖励发放。</COLOR><BR><COLOR VALUE=FFFFFFFF OUTLINE=FF442c20>3、</COLOR><COLOR VALUE=FF442c20>建议要求字数不低于200字。</COLOR><BR><COLOR VALUE=FFFFFFFF OUTLINE=FF442c20>4、</COLOR><COLOR VALUE=FF442c20>玩家的建议每天会审核统计一次，正常为第二日发放奖励，但也可能在当天内就予以发放。</COLOR><BR>]],
			fengce_exchange_describe = [[<COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动时间:</COLOR><COLOR VALUE=FF442c20>新服开服后至礼包激活码领完为止</COLOR><BR><COLOR VALUE=FFFFD200 OUTLINE=FF442c20>活动说明:</COLOR><COLOR VALUE=FF442c20>新服开启后，凡是加入到我们游戏的玩家，都可以通过论坛、媒体专区等途径获得一个价值200钻石的新手礼包。</COLOR>]],
