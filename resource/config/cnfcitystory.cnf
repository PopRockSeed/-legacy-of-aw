			story_id = 1,
			condition = {{4,1,},{4,-2,},{1,-5001,},},
			step = {{1,0,1001,1001,[[噗！（吐了一大口血）没想到多年不见，黑暗邪神居然变得这么利害。我刚耗尽全部法力才得以逃回光明神殿，但是身受重伤，恐怕……]],0.1,},{1,1,1042,1042,[[邪神居然敢控制我朋友，伤我女神，我势必跟他死磕到底！看来得找我哥出马才行！]],0.1,},{1,0,1001,1001,[[呃，你是说那个手上带火的小子？有次说好带他一起飞，结果太烫了，手一哆嗦没抓稳……]],0.1,},{1,1,1042,1042,[[纳尼！那我们快去找他！]],0.1,},},
		},
		[2] = {
			story_id = 2,
			condition = {{2,1011,},{1,-5002,},},
			step = {{1,0,1011,1011,[[刚才那两个黄毛好像是漫画里的人物。他们在玩COSPLAY吗？]],0.1,},{1,1,1042,1042,[[有可能，刚才我还看见有人COS哆啦A梦。这神殿不会是在搞漫展吧！]],0.1,},{1,0,1001,1001,[[这里没有漫展，邪神打破了时空壁垒，很多异界的人被吸进了这个世界。如果放任邪神继续破坏时空，远古魔族就会从时空裂缝中进入我们的世界。那时所有人类都将毁灭。]],0.1,},{1,1,1042,1042,[[哼！我可是要成为贼海王的直男！看来想要回到原来的时空就只能干翻邪神了。]],0.1,},},
		},
		[3] = {
