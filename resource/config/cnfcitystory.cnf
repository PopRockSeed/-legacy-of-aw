			condition = {{2,1004,},{1,-5003,},},
			step = {{1,1,1004,1004,[[哼，别以为我会相信你们什么克隆体的鬼话！]],0.1,},{1,0,1001,1001,[[事实胜于雄辩，我们马上去看看。]],0.1,},},
