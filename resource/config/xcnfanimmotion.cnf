-- Buff用动作 beg -- >>
-- 播放一次骨骼(身上Buff动画)
Config.motion[1] = {
	--{ start=0, fun="off", x=0, y=-50 },
	{ start=0, fun="play_spine", key="animation", loop=false, wait=true },
	{ start=0, fun="end" },
}

-- 显现放大，重复（头顶图片动画）
Config.motion[2] = {
	{ start=0, fun="off", x=0, y=32 },
	{ start=0, fun="scale", factor=0.6 },
	{ start=0, fun="opacity", factor=64 },
	{ start=0, fun="fade_in", time=0.8 },
	{ start=0.2, fun="scale_to", time=0.8, factor=1 },

	{ start=1, fun="fade_to", opacity=128, time=0.8 },
	{ start=1.2, fun="scale_to", time=0.8, factor=0.8 },
	{ start=2, fun="fade_to", opacity=255, time=0.8 },
	{ start=2.2, fun="scale_to", time=0.8, factor=1 },	
    { start=3, fun="repeat", back=4, time_diff=0.5 },
}

-- 上升消失（头顶图片动画）
